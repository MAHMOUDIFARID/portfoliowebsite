---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | FARID MAHMOUDI">
	<main>
		<Navbar />
		
		<!-- Hero Section -->
		<section class="blog-hero pb-20 overflow-hidden">
			<div class="section-container">
				<div class="max-w-4xl text-left reveal-up">
					<p class="text-base md:text-lg text-white/50 leading-relaxed font-light">
						Thoughts, stories, and ideas about software development, data science, and web engineering. View my <a href="/#work" class="underline underline-offset-4 decoration-white/30 hover:decoration-white hover:text-white transition-colors">Selected Projects</a>.
					</p>
				</div>
			</div>
		</section>

		<!-- Blog Posts Grid -->
		<section class="pb-32">
			<div class="section-container">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-x-8 md:gap-y-12">
					{posts.map((post, index) => (
						<a 
							href={`/blog/${post.id}`}
							class="group flex flex-col text-left p-5 md:p-6 rounded-none border transition-all duration-500 reveal-up blog-card-wrapper"
							style={`animation-delay: ${0.2 + index * 0.1}s`}
						>
							<!-- Featured Image Container -->
							{post.data.image && (
								<div class="aspect-[4/3] w-full overflow-hidden rounded-none mb-6 bg-white/[0.02]">
									<img 
										src={post.data.image} 
										alt={post.data.title}
										class="w-full h-full object-cover grayscale-[15%] transition-all duration-700 ease-out-expo group-hover:scale-[1.015] group-hover:grayscale-0"
									/>
								</div>
							)}

							<!-- Details: Title & Diagonal Arrow Link -->
							<div class="flex items-start justify-between gap-3 mt-1">
								<h2 class="blog-post-title text-xl md:text-2xl font-sans font-bold leading-snug">
									{post.data.title}
								</h2>
								<div class="blog-card-arrow pt-1.5 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" class="transform transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
									</svg>
								</div>
							</div>

							<!-- Description -->
							<p class="blog-card-desc mt-3 text-sm md:text-base leading-relaxed font-light line-clamp-3">
								{post.data.description}
							</p>

							<!-- Tags Row of Pill Badges -->
							<div class="flex flex-wrap gap-2 mt-6">
								{post.data.tags.map(tag => (
									<span class="blog-tag-pill border text-[11px] px-3.5 py-1 rounded-full transition-all duration-300">
										{tag}
									</span>
								))}
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<Footer />
	</main>
</Layout>

<style>
	main {
		width: 100%;
		min-height: 100vh;
	}

	.blog-hero {
		padding-top: clamp(9rem, 15vh, 11rem);
	}

	.blog-hero-title {
		font-weight: 800 !important;
	}

	/* Base (Dark Mode) Styles */
	.blog-card-wrapper {
		background-color: rgba(255, 255, 255, 0.03);
		border-color: rgba(255, 255, 255, 0.08);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.blog-card-wrapper:hover {
		border-color: rgba(255, 255, 255, 0.2);
		background-color: rgba(255, 255, 255, 0.05);
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
	}

	.blog-post-title {
		font-weight: 700 !important;
		color: #ffffff !important;
		transition: opacity 0.2s ease;
	}

	.group:hover .blog-post-title {
		opacity: 0.8;
	}

	.blog-card-arrow {
		color: rgba(255, 255, 255, 0.4);
		transition: color 0.2s ease;
	}

	.group:hover .blog-card-arrow {
		color: #ffffff;
	}

	.blog-card-desc {
		color: rgba(255, 255, 255, 0.55);
		transition: color 0.2s ease;
	}

	.blog-tag-pill {
		border-color: rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.5);
	}

	.group:hover .blog-tag-pill {
		border-color: rgba(255, 255, 255, 0.3);
		color: rgba(255, 255, 255, 0.85);
	}

	/* Light Mode Override Styles */
	html.light .blog-card-wrapper {
		background-color: #ffffff;
		border-color: rgba(0, 0, 0, 0.08);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
	}

	html.light .blog-card-wrapper:hover {
		border-color: rgba(0, 0, 0, 0.18);
		background-color: #ffffff;
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.08);
	}

	html.light .blog-post-title {
		color: #111827 !important;
	}

	html.light .blog-card-arrow {
		color: rgba(0, 0, 0, 0.35);
	}

	html.light .group:hover .blog-card-arrow {
		color: #111827;
	}

	html.light .blog-card-desc {
		color: #4b5563;
	}

	html.light .blog-tag-pill {
		border-color: rgba(0, 0, 0, 0.15);
		color: rgba(0, 0, 0, 0.5);
	}

	html.light .group:hover .blog-tag-pill {
		border-color: rgba(0, 0, 0, 0.35);
		color: rgba(0, 0, 0, 0.85);
	}

	@media (max-width: 767px) {
		.blog-hero {
			padding-top: 7rem;
		}
	}
</style>
