---
const languages = [
  {
    name: "العربية / الدارجة",
    level: "لغة أم",
    note: "تواصل يومي"
  },
  {
    name: "Français",
    level: "Professionnel",
    note: "Travail et documentation"
  },
  {
    name: "English",
    level: "Professional",
    note: "Technical writing and collaboration"
  }
];
---

<section id="languages" class="bg-transparent py-20 md:py-28">
  <div class="section-container">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 text-center">
        <h2 class="text-4xl md:text-5xl tracking-tight text-white">
          Languages
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/50">
          Languages I use to communicate, collaborate, and work across different contexts.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {languages.map((language, index) => (
          <div class={`rounded-[1.5rem] border border-white/10 bg-white/[0.03] p-6 text-center transition-colors duration-300 hover:border-white/20 hover:bg-white/[0.055] ${index === 0 ? "language-arabic-card" : ""}`}>
            <h3 class="text-2xl tracking-tight text-white" dir="auto">
              {language.name}
            </h3>
            <p class="mt-3 text-sm text-white/45" dir="auto">
              {language.note}
            </p>
            <div class="mt-6 inline-flex rounded-full border border-white/10 px-4 py-2 text-sm text-white/70" dir="auto">
              {language.level}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .language-arabic-card h3,
  .language-arabic-card p,
  .language-arabic-card div {
    font-family: 'Playpen Sans Arabic', cursive;
  }

  .language-arabic-card h3 {
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: 0;
  }
</style>
