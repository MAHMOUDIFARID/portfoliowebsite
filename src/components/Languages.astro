---
const languages = [
  {
    name: "Arabic / Darija",
    level: "Native",
    note: "Daily communication"
  },
  {
    name: "French",
    level: "Professional",
    note: "Work and documentation"
  },
  {
    name: "English",
    level: "Professional",
    note: "Technical writing and collaboration"
  }
];
---

<section id="languages" class="bg-transparent py-20 md:py-28">
  <div class="section-container">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 text-center">
        <h2 class="text-4xl md:text-5xl tracking-tight text-white">
          Languages
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/50">
          Languages I use to communicate, collaborate, and work across different contexts.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {languages.map((language) => (
          <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.03] p-6 text-center transition-colors duration-300 hover:border-white/20 hover:bg-white/[0.055]">
            <h3 class="text-2xl tracking-tight text-white">
              {language.name}
            </h3>
            <p class="mt-3 text-sm text-white/45">
              {language.note}
            </p>
            <div class="mt-6 inline-flex rounded-full border border-white/10 px-4 py-2 text-sm text-white/70">
              {language.level}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
