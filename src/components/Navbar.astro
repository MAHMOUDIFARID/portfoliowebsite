---
const navLinks = [
  { name: 'Work', href: '/#work' },
  { name: 'Skills', href: '/#skills' },
  { name: 'Experience', href: '/#experience' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="fixed top-6 left-0 w-full z-50 px-4 flex justify-center pointer-events-none">
  <nav 
    class="site-nav-shell pointer-events-auto w-full max-w-[900px] backdrop-blur-xl border rounded-full flex items-center justify-between px-2 py-2 md:px-3 md:py-3 transition-all duration-500"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center group outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded-full pl-2 md:pl-3">
      <div class="w-8 h-8 md:w-9 md:h-9 flex items-center justify-center group-hover:scale-105 transition-transform">
        <img src="/Logo.png" alt="Farid Mahmoudi logo" class="site-nav-logo w-full h-full object-contain transition-all duration-500" />
      </div>
    </a>

    <div class="hidden md:flex items-center gap-2">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="site-nav-link text-[13px] font-medium px-4 py-1.5 rounded-full transition-all outline-none"
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 pr-1">
      <a 
        href="/contact" 
        class="site-nav-cta px-5 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-medium hover:scale-105 transition-transform shadow-sm outline-none hidden md:block"
      >
        Let's talk
      </a>

      <button 
        id="theme-toggle"
        class="site-nav-icon-button w-10 h-10 rounded-full border flex items-center justify-center outline-none transition-colors"
        aria-label="Toggle theme"
      >
        <svg id="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="hidden transition-transform hover:rotate-45 duration-300">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/>
          <path d="M12 20v2"/>
          <path d="m4.93 4.93 1.41 1.41"/>
          <path d="m17.66 17.66 1.41 1.41"/>
          <path d="M2 12h2"/>
          <path d="M20 12h2"/>
          <path d="m6.34 17.66-1.41 1.41"/>
          <path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg id="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="hidden transition-transform hover:-rotate-12 duration-300">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <button 
        id="mobile-menu-btn"
        class="site-nav-icon-button md:hidden w-10 h-10 rounded-full border flex items-center justify-center outline-none transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" class="menu-open-icon"><path d="M224,128a8,8,0,0,1-8,8H32a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM32,72H224a8,8,0,0,0,0-16H32a8,8,0,0,0,0,16ZM224,184H32a8,8,0,0,0,0,16H224a8,8,0,0,0,0-16Z"></path></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" class="menu-close-icon hidden"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path></svg>
      </button>
    </div>
  </nav>
</header>

<div 
  id="mobile-menu"
  class="site-mobile-menu fixed top-24 left-4 right-4 z-40 backdrop-blur-2xl border rounded-3xl p-6 flex flex-col gap-4 opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 md:hidden"
>
  {navLinks.map((link) => (
    <a 
      href={link.href} 
      class="site-nav-link text-lg font-medium px-4 py-3 rounded-2xl transition-colors mobile-link"
    >
      {link.name}
    </a>
  ))}
  <div class="site-mobile-menu-divider h-px w-full my-2"></div>
  <a 
    href="/contact" 
    class="site-nav-cta px-6 py-4 rounded-full text-center text-sm font-semibold transition-colors"
  >
    Let's talk
  </a>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-open-icon');
  const closeIcon = btn?.querySelector('.menu-close-icon');
  const links = document.querySelectorAll('.mobile-link');

  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    if (btn) btn.setAttribute('aria-expanded', isOpen.toString());
    
    if (isOpen) {
      menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  };

  btn?.addEventListener('click', toggleMenu);

  links.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  const themeBtn = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-icon-light');
  const darkIcon = document.getElementById('theme-icon-dark');

  const updateIcon = () => {
    const isLight = document.documentElement.classList.contains('light');
    if (isLight) {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    } else {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    }
  };

  updateIcon();

  themeBtn?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
    updateIcon();
  });
</script>

<style>
  .site-nav-shell,
  .site-mobile-menu {
    background: rgba(10, 10, 10, 0.92);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.34);
  }

  .site-nav-shell:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .site-nav-link {
    color: rgba(255, 255, 255, 0.68);
  }

  .site-nav-logo {
    filter: brightness(0) invert(1);
    opacity: 1;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .site-nav-cta {
    background: #ffffff;
    color: #0a0a0a;
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    background: rgba(255, 255, 255, 0.9);
  }

  .site-nav-icon-button {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .site-nav-icon-button:hover,
  .site-nav-icon-button:focus-visible {
    background: rgba(255, 255, 255, 0.14);
  }

  .site-mobile-menu-divider {
    background: rgba(255, 255, 255, 0.12);
  }

  :global(html.light) .site-nav-shell,
  :global(html.light) .site-mobile-menu {
    background: rgba(255, 255, 255, 0.96);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.12);
  }

  :global(html.light) .site-nav-shell:hover {
    border-color: rgba(0, 0, 0, 0.2);
  }

  :global(html.light) .site-nav-link {
    color: rgba(0, 0, 0, 0.64);
  }

  :global(html.light) .site-nav-logo {
    filter: brightness(0);
  }

  :global(html.light) .site-nav-link:hover,
  :global(html.light) .site-nav-link:focus-visible {
    color: #000000;
    background: rgba(0, 0, 0, 0.05);
  }

  :global(html.light) .site-nav-cta {
    background: #0a0a0a;
    color: #ffffff;
  }

  :global(html.light) .site-nav-cta:hover,
  :global(html.light) .site-nav-cta:focus-visible {
    background: rgba(10, 10, 10, 0.9);
  }

  :global(html.light) .site-nav-icon-button {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
    color: #000000;
  }

  :global(html.light) .site-nav-icon-button:hover,
  :global(html.light) .site-nav-icon-button:focus-visible {
    background: rgba(0, 0, 0, 0.1);
  }

  :global(html.light) .site-mobile-menu-divider {
    background: rgba(0, 0, 0, 0.1);
  }

</style>
