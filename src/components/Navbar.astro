---
const navLinks = [
  { name: 'Work', href: '/#work' },
  { name: 'Services', href: '/services' },
  { name: 'Skills', href: '/#skills' },
  { name: 'Experience', href: '/#experience' },
  { name: 'Playground', href: '/playground' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];
---

<header class="fixed top-0 left-0 w-full z-50 px-6 py-6 sm:px-12 md:px-16 pointer-events-none transition-all duration-500 ease-out-expo">
  <nav 
    class="site-nav-shell pointer-events-auto w-full max-w-[1500px] mx-auto flex items-center justify-between transition-all duration-500"
    aria-label="Main navigation"
  >
    <a href="/" class="flex items-center group outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded-xl">
      <div class="h-6 sm:h-8 md:h-9 w-auto flex items-center group-hover:scale-105 transition-transform">
        <img src="/logobest.png" alt="Farid Mahmoudi logo" class="site-nav-logo h-full w-auto object-contain transition-all duration-500" />
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="site-nav-link text-[14px] font-medium tracking-wide transition-colors outline-none py-1"
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-4 pr-1">
      <a 
        href="/contact" 
        class="site-nav-cta text-[14px] font-semibold tracking-wide transition-all outline-none hidden md:block hover:opacity-80"
      >
        Let's talk
      </a>

      <div class="relative">
        <button 
          id="theme-menu-btn"
          class="site-nav-icon-button w-10 h-10 flex items-center justify-center outline-none transition-colors"
          aria-label="Open appearance settings"
          aria-haspopup="dialog"
        >
          <svg id="theme-icon-light" class="hidden transition-transform hover:rotate-45 duration-300" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2m-15.66 5.66-1.41 1.41m14.14-14.14-1.41 1.41"/>
          </svg>
          <svg id="theme-icon-dark" class="hidden transition-transform hover:-rotate-12 duration-300" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
          <svg id="theme-icon-system" class="hidden transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"/>
            <path d="M12 2v2M12 20v2m-7.1-17.1 1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2m-15.7 5.7-1.4 1.4m14.2-14.2-1.4 1.4"/>
          </svg>
        </button>
      </div>

      <button 
        id="mobile-menu-btn"
        class="site-nav-icon-button md:hidden w-10 h-10 flex items-center justify-center outline-none transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" class="menu-open-icon"><path d="M224,128a8,8,0,0,1-8,8H32a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM32,72H224a8,8,0,0,0,0-16H32a8,8,0,0,0,0,16ZM224,184H32a8,8,0,0,0,0,16H224a8,8,0,0,0,0-16Z"></path></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" class="menu-close-icon hidden"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path></svg>
      </button>
    </div>
  </nav>
</header>

<div 
  id="mobile-menu"
  class="site-mobile-menu absolute top-20 left-0 right-0 z-40 p-8 flex flex-col gap-6 opacity-0 pointer-events-none translate-y-[-10px] transition-all duration-300 md:hidden"
>
  {navLinks.map((link) => (
    <a 
      href={link.href} 
      class="site-nav-link text-lg font-medium py-2 transition-colors mobile-link"
    >
      {link.name}
    </a>
  ))}
  <div class="site-mobile-menu-divider h-px w-full my-1"></div>
  <a 
    href="/contact" 
    class="site-nav-cta text-center text-sm font-semibold py-3 transition-colors inline-block"
  >
    Let's talk
  </a>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-open-icon');
  const closeIcon = btn?.querySelector('.menu-close-icon');
  const links = document.querySelectorAll('.mobile-link');

  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    if (btn) btn.setAttribute('aria-expanded', isOpen.toString());
    
    if (isOpen) {
      menu?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    } else {
      menu?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-10px]');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }
  };

  btn?.addEventListener('click', toggleMenu);

  links.forEach(link => {
    link.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });
  });

  // Theme Button Script: Instant 1-Click Toggle between Light and Dark
  const themeMenuBtn = document.getElementById('theme-menu-btn');
  const lightIcon = document.getElementById('theme-icon-light');
  const darkIcon = document.getElementById('theme-icon-dark');

  const updateThemeUI = (isLight: boolean) => {
    if (isLight) {
      document.documentElement.classList.add('light');
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
    } else {
      document.documentElement.classList.remove('light');
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
    }
  };

  // Initial Sync
  const currentIsLight = document.documentElement.classList.contains('light');
  updateThemeUI(currentIsLight);

  // 1-Click Instant Toggle
  themeMenuBtn?.addEventListener('click', () => {
    const isNowLight = !document.documentElement.classList.contains('light');
    localStorage.setItem('theme', isNowLight ? 'light' : 'dark');
    updateThemeUI(isNowLight);
  });

  // Scroll handling to toggle floating state
  const headerEl = document.querySelector('header');
  const handleScroll = () => {
    if (window.scrollY > 20) {
      headerEl?.classList.add('is-scrolled');
    } else {
      headerEl?.classList.remove('is-scrolled');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();
</script>

<style>
  header {
    transition: padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav-shell {
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;
    border-radius: 9999px;
    padding: 0.5rem 0rem;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  header.is-scrolled {
    padding-top: 1rem !important;
    padding-bottom: 1rem !important;
  }

  header.is-scrolled .site-nav-shell {
    max-width: 950px;
    background: rgba(10, 10, 10, 0.75);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(16px);
    padding: 0.5rem 1.5rem;
  }

  .site-nav-cta {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  header.is-scrolled .site-nav-cta {
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15) !important;
  }

  header.is-scrolled .site-nav-cta:hover {
    background: rgba(255, 255, 255, 0.15);
    opacity: 1 !important;
  }

  .site-nav-link {
    color: rgba(255, 255, 255, 0.6);
  }

  .site-nav-logo {
    opacity: 1;
  }

  .site-nav-link:hover,
  .site-nav-link:focus-visible {
    color: #ffffff;
  }

  .site-nav-cta {
    color: #ffffff;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.3);
  }

  .site-nav-cta:hover,
  .site-nav-cta:focus-visible {
    border-bottom-color: #ffffff;
  }

  .site-nav-icon-button {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
  }

  .site-nav-icon-button:hover,
  .site-nav-icon-button:focus-visible {
    color: #ffffff;
  }

  .site-mobile-menu {
    position: fixed;
    top: 6rem;
    left: 1.5rem;
    right: 1.5rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  header.is-scrolled ~ .site-mobile-menu {
    top: 4.75rem;
  }

  .site-mobile-menu-divider {
    background: rgba(255, 255, 255, 0.08);
  }

  .site-nav-logo {
    filter: brightness(0) invert(1);
  }

  /* Light Theme */
  :global(html.light) .site-nav-logo {
    filter: brightness(0);
  }

  :global(html.light) .site-nav-link {
    color: rgba(0, 0, 0, 0.6);
  }

  :global(html.light) .site-nav-link:hover,
  :global(html.light) .site-nav-link:focus-visible {
    color: #000000;
  }

  :global(html.light) .site-nav-cta {
    color: #000000;
    border-bottom-color: rgba(0, 0, 0, 0.2);
  }

  :global(html.light) .site-nav-cta:hover,
  :global(html.light) .site-nav-cta:focus-visible {
    border-bottom-color: #000000;
  }

  :global(html.light) .site-nav-icon-button {
    color: rgba(0, 0, 0, 0.6);
  }

  :global(html.light) .site-nav-icon-button:hover,
  :global(html.light) .site-nav-icon-button:focus-visible {
    color: #000000;
  }

  :global(html.light) .site-mobile-menu {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  :global(html.light) header.is-scrolled .site-nav-shell {
    background: rgba(255, 255, 255, 0.75);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.1);
  }

  :global(html.light) header.is-scrolled .site-nav-cta {
    border-color: rgba(0, 0, 0, 0.15) !important;
    background: rgba(0, 0, 0, 0.05);
    color: #000000;
  }

  :global(html.light) header.is-scrolled .site-nav-cta:hover {
    background: rgba(0, 0, 0, 0.1);
  }

  :global(html.light) .site-mobile-menu-divider {
    background: rgba(0, 0, 0, 0.08);
  }

  /* Theme Modal Styles */
  #theme-modal-overlay {
    backdrop-filter: blur(0px);
    transition: backdrop-filter 0.3s ease, opacity 0.3s ease;
  }
  
  #theme-modal-overlay.backdrop-blur-md {
    backdrop-filter: blur(12px);
  }

  .theme-opt-row {
    color: rgb(var(--color-white-base) / 0.5);
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-opt-row:hover {
    color: rgb(var(--color-white-base) / 0.85);
  }

  .theme-opt-row.active {
    color: var(--site-bg) !important;
  }

  #theme-active-indicator {
    background: rgb(var(--color-white-base));
  }
</style>
