<section id="profile" class="relative w-full flex flex-col items-center justify-center text-center px-6 pt-32 pb-20 sm:pt-40 sm:pb-28 md:pt-44 md:pb-32 overflow-hidden">
  
  <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center text-center">
    
    {/* Hero Heading matching reference image */}
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-neutral-900 dark:text-white leading-[1.15] mb-8 font-sans">
      Hey, I'm Farid 👋<br />
      I engineer web applications, automated workflows, & AI solutions that feel <span class="italic font-light text-neutral-500 dark:text-neutral-400 font-serif">simple.</span>
    </h1>

