---
<section class="relative min-h-screen w-full flex flex-col items-center justify-start text-center px-6 pt-16 sm:pt-20 md:pt-20 overflow-hidden">
  
  <div class="relative z-10 w-full max-w-[1500px] mx-auto flex flex-col items-center">
    <div class="relative w-full min-h-[calc(100vh-5rem)] flex items-start justify-center">
      <div class="reveal-up absolute left-0 sm:left-4 lg:left-8 top-[18%] sm:top-[20%] z-30 max-w-[350px] sm:max-w-[480px] text-left" style="animation-delay: 0.1s;">
        <h1 class="flex flex-col text-[80px] sm:text-[110px] lg:text-[160px] leading-[0.7] tracking-normal text-white mb-2 font-statix">
          <span class="text-xl sm:text-2xl lg:text-3xl text-white/50 font-semibold mb-2 sm:mb-4 tracking-[0.2em] uppercase font-statix ml-1 inline-flex items-center">
            Hi, I am
          </span>
          <span class="font-statix bg-clip-text text-transparent bg-gradient-to-br from-white via-white/95 to-white/40 drop-shadow-lg pb-4 pl-2 -mt-4 origin-left hover:scale-[1.02] transition-transform duration-500 inline-flex items-center">
            FARID
          </span>
        </h1>
        
        <a href="/motivation" class="group mt-8 ml-1 inline-flex items-center gap-3 px-8 py-4 bg-white text-brand-black rounded-full text-[15px] sm:text-base font-bold transition-all duration-300 hover:scale-[1.03] shadow-[0_8px_30px_rgb(255,255,255,0.12)] hover:shadow-[0_8px_40px_rgb(255,255,255,0.2)]">
          <div class="relative flex h-2.5 w-2.5 items-center justify-center">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-black opacity-50"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-black"></span>
          </div>
          <span class="tracking-wide">If you have time, read this</span>
          <div class="bg-brand-black/10 rounded-full p-1 group-hover:bg-brand-black/20 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>
      </div>
      <div class="reveal-up relative z-20 h-[calc(100vh-2.5rem)] min-h-[760px] max-h-[1080px] w-[min(142vw,1750px)]" style="animation-delay: 0.2s;">
        <img src="/mee.png" alt="Farid Mahmoudi" class="w-full h-full object-contain object-top drop-shadow-[0_36px_60px_rgba(0,0,0,0.55)]" style="-webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%); mask-image: linear-gradient(to bottom, black 80%, transparent 100%);" />
      </div>
    </div>
  </div>
</section>
