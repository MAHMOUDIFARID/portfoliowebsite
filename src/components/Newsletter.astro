---
---

<section id="updates" class="bg-transparent py-20 md:py-28">
  <div class="section-container">
    <div class="mx-auto max-w-4xl rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-6 md:p-8">
      <div class="space-y-7 text-center">
        <div>
          <h2 class="mx-auto max-w-2xl text-3xl leading-tight tracking-tight text-white md:text-4xl">
            Get new blogs and projects in your inbox.
          </h2>
          <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-white/45">
            No spam. Only updates when I publish a new blog or finish a project worth sharing.
          </p>
        </div>

        <form
          action="https://formsubmit.co/faridmahmoudicontact@gmail.com"
          method="POST"
          class="space-y-4"
        >
          <input type="hidden" name="_subject" value="New portfolio updates subscriber" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

          <label class="sr-only" for="subscriber-email">Email address</label>
          <div class="mx-auto grid max-w-md gap-3">
            <input
              id="subscriber-email"
              type="email"
              name="email"
              required
              placeholder="your@email.com"
              class="min-h-14 w-full rounded-2xl border border-white/12 bg-white/[0.035] px-5 text-center text-base text-white outline-none transition-colors placeholder:text-white/30 focus:border-white/35"
            />
            <button
              type="submit"
              class="min-h-14 w-full rounded-2xl bg-white px-8 text-base text-brand-black transition-colors duration-300 hover:bg-white/90 cursor-pointer"
            >
              Subscribe
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
