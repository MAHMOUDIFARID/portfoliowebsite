---
const skills = [
  { name: "Python", logo: "/logos/skills/python.svg" },
  { name: "SQL", logo: "/logos/skills/sql.svg" },
  { name: "PostgreSQL", logo: "/logos/skills/postgresql.svg" },
  { name: "Google Cloud", logo: "/logos/skills/google-cloud.svg" },
  { name: "Apache Spark", logo: "/logos/skills/apache-spark.svg" },
  { name: "Docker", logo: "/logos/skills/docker.svg" },
  { name: "Git", logo: "/logos/skills/git.svg" },
  { name: "GitHub", logo: "/logos/skills/github.svg" },
  { name: "Node.js", logo: "/logos/skills/nodejs.svg" },
  { name: "React", logo: "/logos/skills/react.svg" },
  { name: "Next.js", logo: "/logos/skills/nextjs.svg" },
  { name: "Astro", logo: "/logos/skills/astro.svg" },
  { name: "TypeScript", logo: "/logos/skills/typescript.svg" },
  { name: "JavaScript", logo: "/logos/skills/javascript.svg" },
  { name: "Tailwind CSS", logo: "/logos/skills/tailwindcss.svg" },
  { name: "FastAPI", logo: "/logos/skills/fastapi.svg" },
  { name: "Supabase", logo: "/logos/skills/supabase.svg" },
  { name: "Pandas", logo: "/logos/skills/pandas.svg" },
  { name: "Scikit-Learn", logo: "/logos/skills/scikit-learn.svg" },
  { name: "Figma", logo: "/logos/skills/figma.svg" }
];

// Duplicate skills array to ensure seamless 100% infinite marquee loop
const marqueeSkills1 = [...skills, ...skills];
const marqueeSkills2 = [...skills.slice(6), ...skills.slice(0, 6), ...skills.slice(6), ...skills.slice(0, 6)];
---

<section id="skills" class="relative py-24 md:py-32 bg-transparent overflow-hidden">
  
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-6 mb-12 text-center">
    <!-- Title matching reference screenshot -->
    <h2 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-neutral-900 dark:text-white font-sans">
      Technologies I Use
    </h2>
  </div>

  <!-- Infinite Marquee Slider Container -->
  <div class="relative w-full overflow-hidden py-4">
    
    <!-- Gradient Fade Masks on Left & Right Edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 w-24 md:w-44 bg-gradient-to-r from-white dark:from-brand-black to-transparent z-10"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-24 md:w-44 bg-gradient-to-l from-white dark:from-brand-black to-transparent z-10"></div>

    <!-- Row 1: Right-to-Left Infinite Marquee -->
    <div class="flex w-max gap-4 sm:gap-6 animate-marquee-left">
      {marqueeSkills1.map((tech) => (
        <div class="flex items-center gap-3.5 px-6 sm:px-7 py-3.5 sm:py-4 bg-neutral-100 dark:bg-[#070e1b] border border-neutral-200 dark:border-white/10 rounded-xl sm:rounded-2xl shadow-sm hover:border-neutral-300 dark:hover:border-white/25 transition-all shrink-0 group cursor-default">
          <img 
            src={tech.logo} 
            alt={tech.name} 
            class={`w-6 h-6 sm:w-7 sm:h-7 object-contain opacity-90 group-hover:scale-110 transition-transform duration-300 ${tech.name === "GitHub" ? "dark:invert" : ""}`}
            loading="lazy"
          />
          <span class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white tracking-tight whitespace-nowrap">
            {tech.name}
          </span>
        </div>
      ))}
    </div>

    <!-- Row 2: Dual Direction Marquee -->
    <div class="flex w-max gap-4 sm:gap-6 animate-marquee-right mt-4 sm:mt-6">
      {marqueeSkills2.map((tech) => (
        <div class="flex items-center gap-3.5 px-6 sm:px-7 py-3.5 sm:py-4 bg-neutral-100 dark:bg-[#070e1b] border border-neutral-200 dark:border-white/10 rounded-xl sm:rounded-2xl shadow-sm hover:border-neutral-300 dark:hover:border-white/25 transition-all shrink-0 group cursor-default">
          <img 
            src={tech.logo} 
            alt={tech.name} 
            class={`w-6 h-6 sm:w-7 sm:h-7 object-contain opacity-90 group-hover:scale-110 transition-transform duration-300 ${tech.name === "GitHub" ? "dark:invert" : ""}`}
            loading="lazy"
          />
          <span class="text-sm sm:text-base font-semibold text-neutral-900 dark:text-white tracking-tight whitespace-nowrap">
            {tech.name}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes marquee-left {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0%); }
  }

  .animate-marquee-left {
    animation: marquee-left 35s linear infinite;
  }

  .animate-marquee-right {
    animation: marquee-right 35s linear infinite;
  }

  .animate-marquee-left:hover,
  .animate-marquee-right:hover {
    animation-play-state: paused;
  }
</style>
