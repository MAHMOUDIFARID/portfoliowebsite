---
const skills = [
  {
    category: "Frontend",
    items: [
      { name: "Astro", logo: "/logos/skills/astro.svg", alt: "Astro logo" },
      { name: "React", logo: "/logos/skills/react.svg", alt: "React logo" },
      { name: "Next.js", logo: "/logos/skills/nextjs.svg", alt: "Next.js logo" },
      { name: "Tailwind CSS", logo: "/logos/skills/tailwindcss.svg", alt: "Tailwind CSS logo" },
      { name: "TypeScript", logo: "/logos/skills/typescript.svg", alt: "TypeScript logo" },
      { name: "JavaScript", logo: "/logos/skills/javascript.svg", alt: "JavaScript logo" }
    ]
  },
  {
    category: "Backend & Data",
    items: [
      { name: "Big Data", logo: "/logos/skills/apache-spark.svg", alt: "Apache Spark logo" },
      { name: "Cloud Computing", logo: "/logos/skills/google-cloud.svg", alt: "Google Cloud logo" },
      { name: "Drupal", logo: "/logos/skills/drupal.svg", alt: "Drupal logo" },
      { name: "Node.js", logo: "/logos/skills/nodejs.svg", alt: "Node.js logo" },
      { name: "Python", logo: "/logos/skills/python.svg", alt: "Python logo" }
    ]
  },
  {
    category: "Tools & Others",
    items: [
      { name: "Git", logo: "/logos/skills/git.svg", alt: "Git logo" },
      { name: "Docker", logo: "/logos/skills/docker.svg", alt: "Docker logo" },
      { name: "Figma", logo: "/logos/skills/figma.svg", alt: "Figma logo" },
      { name: "Agile", logo: "/logos/skills/jira.svg", alt: "Jira logo" },
      { name: "SEO", logo: "/logos/skills/google-search-console.svg", alt: "Google Search Console logo" }
    ]
  }
];
---

<section id="skills" class="py-24 md:py-32 bg-transparent">
  <div class="section-container">
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-semibold tracking-tighter text-white mb-4">
        Skills & Expertise
      </h2>
      <div class="w-16 h-1 bg-white/20 rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {skills.map((skillGroup) => (
        <div class="glass-card p-8 rounded-3xl group hover:border-white/20 transition-colors duration-500">
          <h3 class="text-xs font-medium uppercase tracking-widest text-white/30 mb-6 group-hover:text-white/50 transition-colors">
            {skillGroup.category}
          </h3>
          <div class="flex flex-wrap gap-3">
            {skillGroup.items.map((skill) => (
              <span class="inline-flex items-center gap-2 px-3 py-2 bg-white/5 border border-white/10 rounded-full text-sm font-medium text-white/70 hover:bg-white/10 hover:text-white transition-all duration-300">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white/95 ring-1 ring-white/10">
                  <img src={skill.logo} alt={skill.alt} class="h-4 w-4 object-contain" loading="lazy" />
                </span>
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
