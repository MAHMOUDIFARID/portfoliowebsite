---
const skills = [
  {
    category: "Data Science & Big Data",
    outcome: "Build reliable data workflows, analyze large datasets, and train models that support practical decisions.",
    fit: "Best fit: Data Science, ML, Big Data, analytics engineering.",
    items: [
      { name: "Python", logo: "/logos/skills/python.svg", alt: "Python logo" },
      { name: "Big Data (Spark)", logo: "/logos/skills/apache-spark.svg", alt: "Apache Spark logo" },
      { name: "Cloud (GCP)", logo: "/logos/skills/google-cloud.svg", alt: "Google Cloud logo" },
      { name: "TypeScript", logo: "/logos/skills/typescript.svg", alt: "TypeScript logo" },
      { name: "JavaScript", logo: "/logos/skills/javascript.svg", alt: "JavaScript logo" }
    ]
  },
  {
    category: "Operations & MLOps",
    outcome: "Package, version, and maintain project environments so data and web work stays reproducible.",
    fit: "Best fit: junior data roles, ML projects, cloud-ready development teams.",
    items: [
      { name: "Git", logo: "/logos/skills/git.svg", alt: "Git logo" },
      { name: "Docker", logo: "/logos/skills/docker.svg", alt: "Docker logo" },
      { name: "Node.js", logo: "/logos/skills/nodejs.svg", alt: "Node.js logo" },
      { name: "Agile (Jira)", logo: "/logos/skills/jira.svg", alt: "Jira logo" }
    ]
  },
  {
    category: "Visualization & Interfaces",
    outcome: "Turn backend logic and data outputs into clean interfaces, dashboards, and portfolio-ready products.",
    fit: "Best fit: frontend, data apps, dashboards, and product-minded engineering.",
    items: [
      { name: "React", logo: "/logos/skills/react.svg", alt: "React logo" },
      { name: "Next.js", logo: "/logos/skills/nextjs.svg", alt: "Next.js logo" },
      { name: "Astro", logo: "/logos/skills/astro.svg", alt: "Astro logo" },
      { name: "Tailwind CSS", logo: "/logos/skills/tailwindcss.svg", alt: "Tailwind CSS logo" },
      { name: "Figma", logo: "/logos/skills/figma.svg", alt: "Figma logo" }
    ]
  }
];
---

<section id="skills" class="py-24 md:py-32 bg-transparent">
  <div class="section-container">
    <div class="recruiter-skills mx-auto max-w-7xl">
      <div class="skills-brief">
        <p class="skills-kicker">Recruiter snapshot</p>
        <h2>What I can bring to a team</h2>
        <p>
          A practical mix of data science, big data tooling, and frontend development for teams that need someone who can understand the pipeline and still care about the final user experience.
        </p>
      </div>

      <div class="capability-list">
        {skills.map((skillGroup, index) => (
          <article class="capability-row">
            <div class="capability-heading">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{skillGroup.category}</h3>
            </div>

            <div class="capability-copy">
              <p>{skillGroup.outcome}</p>
              <small>{skillGroup.fit}</small>
            </div>

            <div class="tool-strip">
              {skillGroup.items.map((skill) => (
                <div class="tool-chip">
                  <img src={skill.logo} alt={skill.alt} loading="lazy" />
                  <span>{skill.name}</span>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .recruiter-skills {
    display: grid;
    gap: 2.5rem;
  }

  .skills-brief {
    max-width: 56rem;
  }

  .skills-kicker {
    margin-bottom: 1rem;
    color: rgb(var(--color-white-base) / 0.42);
    font-size: 0.75rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .skills-brief h2 {
    color: rgb(var(--color-white-base));
    font-size: clamp(2.5rem, 5.5vw, 5.25rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .skills-brief > p {
    margin-top: 1.35rem;
    max-width: 46rem;
    color: rgb(var(--color-white-base) / 0.56);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .capability-list {
    border-top: 1px solid rgb(var(--color-white-base) / 0.12);
  }

  .capability-row {
    display: grid;
    gap: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-white-base) / 0.12);
    padding: 1.8rem 0;
  }

  .capability-row:last-child {
    border-bottom: 0;
  }

  .capability-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .capability-heading span {
    color: rgb(var(--color-white-base) / 0.36);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
  }

  .capability-heading h3 {
    color: rgb(var(--color-white-base));
    font-size: clamp(1.5rem, 2.5vw, 2.65rem);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .capability-copy p {
    max-width: 35rem;
    color: rgb(var(--color-white-base) / 0.68);
    font-size: 1rem;
    line-height: 1.65;
  }

  .capability-copy small {
    display: block;
    margin-top: 0.85rem;
    color: rgb(var(--color-white-base) / 0.42);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .tool-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgb(var(--color-white-base) / 0.09);
    border-radius: 999px;
    padding: 0.65rem 0.9rem;
    color: rgb(var(--color-white-base) / 0.68);
    background: rgb(var(--color-white-base) / 0.025);
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .tool-chip:hover {
    transform: translateY(-1px);
    border-color: rgb(var(--color-white-base) / 0.22);
    background: rgb(var(--color-white-base) / 0.055);
    color: rgb(var(--color-white-base));
  }

  .tool-chip img {
    height: 1rem;
    width: 1rem;
    object-fit: contain;
    opacity: 0.72;
    filter: grayscale(1);
    transition: filter 180ms ease, opacity 180ms ease;
  }

  .tool-chip:hover img {
    opacity: 1;
    filter: grayscale(0);
  }

  .tool-chip span {
    font-size: 0.86rem;
  }

  @media (min-width: 768px) {
    .capability-row {
      grid-template-columns: 0.9fr 1fr;
      gap: 2rem;
      padding: 2.2rem 0;
    }

    .tool-strip {
      grid-column: 2;
    }
  }

  @media (min-width: 1024px) {
    .recruiter-skills {
      grid-template-columns: 0.75fr 1.25fr;
      align-items: start;
  }

    .skills-brief {
      position: sticky;
      top: 7rem;
    }

    .capability-row {
      grid-template-columns: 0.75fr 1fr;
    }
  }
</style>
