---
const skills = [
  {
    category: "Data Science & Big Data",
    desc: "Analyzing large datasets, building machine learning pipelines, and deploying cloud computing resources.",
    items: [
      { name: "Python", logo: "/logos/skills/python.svg", alt: "Python logo" },
      { name: "Big Data (Spark)", logo: "/logos/skills/apache-spark.svg", alt: "Apache Spark logo" },
      { name: "Cloud (GCP)", logo: "/logos/skills/google-cloud.svg", alt: "Google Cloud logo" },
      { name: "TypeScript", logo: "/logos/skills/typescript.svg", alt: "TypeScript logo" },
      { name: "JavaScript", logo: "/logos/skills/javascript.svg", alt: "JavaScript logo" }
    ]
  },
  {
    category: "Operations & MLOps",
    desc: "Managing data version control, containerized application environments, backend systems, and agile planning.",
    items: [
      { name: "Git", logo: "/logos/skills/git.svg", alt: "Git logo" },
      { name: "Docker", logo: "/logos/skills/docker.svg", alt: "Docker logo" },
      { name: "Node.js", logo: "/logos/skills/nodejs.svg", alt: "Node.js logo" },
      { name: "Agile (Jira)", logo: "/logos/skills/jira.svg", alt: "Jira logo" }
    ]
  },
  {
    category: "Visualization & Interfaces",
    desc: "Engineering premium user interfaces, interactive data dashboards, and functional web applications.",
    items: [
      { name: "React", logo: "/logos/skills/react.svg", alt: "React logo" },
      { name: "Next.js", logo: "/logos/skills/nextjs.svg", alt: "Next.js logo" },
      { name: "Astro", logo: "/logos/skills/astro.svg", alt: "Astro logo" },
      { name: "Tailwind CSS", logo: "/logos/skills/tailwindcss.svg", alt: "Tailwind CSS logo" },
      { name: "Figma", logo: "/logos/skills/figma.svg", alt: "Figma logo" }
    ]
  }
];
---

<section id="skills" class="py-24 md:py-32 bg-transparent border-t border-white/5">
  <div class="max-w-[1500px] mx-auto px-6 sm:px-12 md:px-16">
    <!-- Centered Header -->
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <p class="text-[10px] font-bold tracking-[0.25em] text-white/40 uppercase mb-3 select-none">
        TECHNICAL TOOLKIT
      </p>
      <h2 class="text-4xl sm:text-5xl font-sans font-black text-white tracking-tighter leading-none mb-6">
        Skills & Expertise
      </h2>
      <p class="text-sm sm:text-base text-white/50 font-sans font-light leading-relaxed">
        A carefully selected collection of frameworks, languages, and tools leveraged to build data pipelines, train machine learning models, and engineer interactive data apps.
      </p>
    </div>

    <!-- 3-Column Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {skills.map((skillGroup) => (
        <div class="glass-card rounded-3xl p-6 md:p-8 flex flex-col h-full hover:border-white/20 hover:bg-white/[0.07] hover:shadow-2xl hover:shadow-white/[0.02] hover:-translate-y-1 transition-all duration-300">
          <div class="mb-8">
            <h3 class="text-xl font-bold text-white tracking-tight mb-3">
              {skillGroup.category}
            </h3>
            <p class="text-sm text-white/50 font-light leading-relaxed">
              {skillGroup.desc}
            </p>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-auto">
            {skillGroup.items.map((skill) => (
              <div class="group/item flex items-center gap-2.5 px-3.5 py-2 bg-white/[0.02] border border-white/5 rounded-full text-white/60 hover:text-white hover:bg-white/[0.08] hover:border-white/15 transition-all duration-300 cursor-default">
                <div class="w-4 h-4 flex items-center justify-center filter grayscale opacity-60 group-hover/item:opacity-100 group-hover/item:grayscale-0 transition-all duration-300">
                  <img src={skill.logo} alt={skill.alt} class="max-h-full max-w-full object-contain" loading="lazy" />
                </div>
                <span class="text-xs font-normal tracking-wide">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


