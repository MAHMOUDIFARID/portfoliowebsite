---
const projects = [
  {
    title: "Mitex",
    description: "A premium, data-driven product sourcing and supplier intelligence SaaS for COD e-commerce operators, replacing manual sourcing with real-time database statistics and a responsive analytics dashboard.",
    tags: ["Next.js", "TypeScript", "Tailwind CSS v4", "Firebase", "Node.js"],
    image: "/mitex.png",
    link: null,
    comingSoon: true,
    visual: "normal"
  },
  {
    title: "Maroc Des Merveilles",
    description: "A Drupal website for presenting Morocco's destinations and travel experiences through structured content.",
    tags: ["Drupal", "PHP", "MySQL", "Twig"],
    image: "/Marocdesmerveilles.png",
    link: "https://marocdesmerveilles.com",
    visual: "normal"
  },
  {
    title: "Dades Mgoun",
    description: "Official web platform for the Association of Tourist Accommodations in the Rose Valley communes (Dades & Mgoun, Morocco). Built on Drupal 10, featuring a directory for local guesthouses, hotels, eco-lodges, regional tourism promotion, and interactive guest booking.",
    tags: ["Drupal 10", "PHP", "Bootstrap 5", "Twig", "MySQL"],
    image: "/dadesmgoun.png",
    link: "https://www.dadesmgoun.com",
    visual: "normal"
  },
  {
    title: "Dar Timitar",
    description: "An authentic Berber Kasbah & Ecolodge web platform in the Rose Valley (Morocco) featuring panoramic room bookings, local gastronomy menus, regional tour excursions, and online payments.",
    tags: ["Drupal", "PHP", "MySQL", "Twig"],
    image: "/dartimitar.png",
    link: "http://www.dartimitar.com/",
    visual: "normal"
  },
  {
    title: "TidyX",
    description: "A safe, undoable Python CLI for organizing messy folders. It scans files, previews moves with dry-run, normalizes filenames, detects duplicates with SHA-256, generates storage reports, supports YAML rules, and records operation history for safe undo.",
    tags: ["Python", "Typer", "Pydantic", "Rich"],
    image: "/tidyx.png",
    link: "https://github.com/MAHMOUDIFARID/tidyx",
    logoPreview: false,
    visual: "logo"
  },
  {
    title: "Malicious QR Code Detection",
    description: "A machine learning project for detecting malicious QR codes used in quishing attacks. Built a full pipeline for data loading, EDA, image preprocessing, feature extraction, model training, evaluation, and inference on a balanced Kaggle dataset of 200,000 QR images, with a focus on improving malicious-code recall.",
    tags: ["Python", "Machine Learning", "EDA", "Image Processing"],
    image: "/quishing.png",
    link: "https://github.com/MAHMOUDIFARID/quishing-detection",
    visual: "normal"
  },
  {
    title: "Bdarija Translator Extension",
    description: "A production-grade, DOM-preserving browser extension that translates webpage content into Moroccan Darija in real-time, utilizing a secure Node.js backend integration with the Gemini Live API and SHA-256 caching for performance.",
    tags: ["React", "TypeScript", "WXT", "Hono", "Node.js", "Tailwind CSS"],
    image: "/bdarija.png",
    link: "https://github.com/MAHMOUDIFARID/bdarija-extension",
    visual: "normal"
  }
];
---

<section id="work" class="pt-0 pb-32 md:pt-0 md:pb-48 bg-transparent overflow-hidden">
  <div class="section-container mb-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-white mb-4">
          Selected Projects
        </h2>
        <p class="text-lg md:text-xl text-white/50 max-w-2xl font-medium">
          Real projects with clear technology stacks and practical use cases.
        </p>
      </div>
      
      <!-- Carousel Navigation Buttons -->
      <div class="flex gap-3">
        <button id="prev-btn" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-white hover:border-white/20 hover:bg-white/5 transition-all duration-300 active:scale-95 cursor-pointer" aria-label="Previous Project">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 256 256"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
        </button>
        <button id="next-btn" class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center text-white/60 hover:text-white hover:border-white/20 hover:bg-white/5 transition-all duration-300 active:scale-95 cursor-pointer" aria-label="Next Project">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 256 256"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Carousel Wrapper (Clean 3-Card Container, No Bleeding Right) -->
  <div class="relative w-full max-w-[1400px] mx-auto px-6 overflow-hidden">
    <div 
      id="project-carousel" 
      class="flex overflow-x-auto snap-x snap-mandatory gap-6 md:gap-8 scroll-smooth pb-8"
    >
      {projects.map((project) => {
        const isGitHub = project.link?.includes("github.com") ?? false;
        return (
          <div class="snap-start shrink-0 w-full sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4rem)/3)] min-h-[580px] bg-brand-charcoal border border-neutral-200 dark:border-white/10 rounded-[2.5rem] overflow-hidden hover:border-neutral-400 dark:hover:border-white/20 transition-all duration-500 hover:shadow-2xl flex flex-col group/card relative">
            <!-- Top half: Image / Logo -->
            <div class="relative w-full h-[230px] overflow-hidden shrink-0">
              {project.visual === "qr" ? (
                <div class="qr-project-visual">
                  <div class="qr-grid" aria-hidden="true">
                    {Array.from({ length: 49 }).map((_, index) => (
                      <span class={`qr-cell ${(index * 7 + index + 3) % 5 === 0 || [0, 1, 2, 7, 14, 34, 41, 48, 46, 45, 44, 6, 13, 20].includes(index) ? "active" : ""}`}></span>
                    ))}
                  </div>
                  <div class="qr-scan-line"></div>
                  <span class="qr-label">Quishing Detection</span>
                </div>
              ) : project.logoPreview ? (
                <div class="flex h-full w-full items-center justify-center bg-white/[0.03]">
                  <img 
                    src={project.image} 
                    alt={project.title} 
                    class="h-20 w-20 object-contain opacity-70 transition-transform duration-700 group-hover/card:scale-110 group-hover/card:opacity-90"
                  />
                </div>
              ) : (
                <img 
                  src={project.image} 
                  alt={project.title} 
                  class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-[1000ms] opacity-60 group-hover/card:opacity-80 transition-opacity"
                />
              )}
              <!-- Dark gradient fade overlay to card background -->
              <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal via-brand-charcoal/20 to-transparent"></div>
            </div>

            <!-- Bottom half: Info & Action Button -->
            <div class="flex-1 p-6 md:p-8 flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-semibold text-neutral-900 dark:text-white mb-2 tracking-tight">
                  {project.title}
                </h3>
                <p class="text-sm text-neutral-600 dark:text-white/50 mb-6 leading-relaxed font-light" set:html={project.description}>
                </p>
              </div>

              <div>
                <!-- Badges -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.tags.map(tag => (
                    <span class="px-3.5 py-1.5 bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-700 dark:text-white/70 text-xs font-normal tracking-wide rounded-full cursor-default hover:bg-neutral-200 dark:hover:bg-white/[0.08] transition-all duration-300">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- Call to Action Button -->
                {project.comingSoon ? (
                  <div class="w-full bg-neutral-200 dark:bg-white/10 text-neutral-600 dark:text-white/60 py-4 px-6 rounded-full text-sm font-semibold flex items-center justify-center gap-2 cursor-default select-none border border-neutral-300 dark:border-white/10">
                    <span>Coming Soon</span>
                    <span>⏳</span>
                  </div>
                ) : project.link && (
                  <a 
                    href={project.link} 
                    target="_blank"
                    rel="noreferrer"
                    class="w-full bg-neutral-900 dark:bg-white text-white dark:text-brand-black py-4 px-6 rounded-full text-sm font-semibold hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 shadow-lg"
                  >
                    <span>{isGitHub ? "Visit GitHub Repository" : "Visit Live Site"}</span>
                    {isGitHub ? (
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    ) : (
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256">
                        <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM215.17,120H176.62c-2.31-29.21-12.87-55.51-28.53-73.49A88.16,88.16,0,0,1,215.17,120ZM128,40.17c16,21.57,26.54,49.25,28.43,79.83H99.57C101.46,89.42,112,61.74,128,40.17ZM40.83,120A88.16,88.16,0,0,1,107.91,46.51C92.25,64.49,81.69,90.79,79.38,120ZM40.83,136H79.38c2.31,29.21,12.87,55.51,28.53,73.49A88.16,88.16,0,0,1,40.83,136Zm87.17,79.83C112,194.26,101.46,166.58,99.57,136h56.86C154.54,166.58,144,194.26,128,219.83Zm20.09-6.34C163.75,195.51,174.31,169.21,176.62,136h38.55A88.16,88.16,0,0,1,148.09,213.49Z"/>
                      </svg>
                    )}
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Indicator Dots -->
  <div class="flex justify-center gap-2.5 mt-8">
    {projects.map((_, index) => (
      <button 
        class="carousel-dot w-2.5 h-2.5 rounded-full bg-neutral-300 dark:bg-white/20 hover:bg-neutral-400 dark:hover:bg-white/40 transition-all duration-300 cursor-pointer"
        data-index={index}
        aria-label={`Go to slide ${index + 1}`}
      ></button>
    ))}
  </div>
</section>

<style>
  #project-carousel {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  #project-carousel::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
  
  /* Active Indicator Pill Style */
  .carousel-dot.active {
    width: 24px;
    background-color: rgba(255, 255, 255, 0.85);
  }
  
  html.light .carousel-dot.active {
    background-color: rgba(0, 0, 0, 0.85);
  }
  html.light .carousel-dot {
    background-color: rgba(0, 0, 0, 0.15);
  }

  .qr-project-visual {
    position: relative;
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.14), transparent 26%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.02));
  }

  .qr-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    width: 116px;
    height: 116px;
    padding: 12px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.28);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.32);
  }

  .qr-cell {
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.18);
  }

  .qr-cell.active {
    background: rgba(255, 255, 255, 0.92);
  }

  .qr-scan-line {
    position: absolute;
    left: 24%;
    right: 24%;
    top: 48%;
    height: 1px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.7);
  }

  .qr-label {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.28);
    padding: 8px 14px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

<script>
  const carousel = document.getElementById('project-carousel');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const dots = document.querySelectorAll('.carousel-dot');

  if (carousel) {
    // Handle Next / Prev Clicks
    const getScrollAmount = () => {
      const firstCard = carousel.querySelector('.snap-start');
      if (firstCard) {
        const style = window.getComputedStyle(carousel);
        const gap = parseInt(style.gap || '32', 10);
        const cardsToScroll = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 640 ? 2 : 1;
        return (firstCard.clientWidth + gap) * cardsToScroll;
      }
      return carousel.clientWidth;
    };

    prevBtn?.addEventListener('click', () => {
      carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    // Update Active Dot
    const updateActiveDot = () => {
      const scrollPosition = carousel.scrollLeft;
      const firstCard = carousel.querySelector('.snap-start');
      if (!firstCard) return;

      const style = window.getComputedStyle(carousel);
      const gap = parseInt(style.gap || '32', 10);
      const cardWidth = firstCard.clientWidth + gap;
      const activeIndex = Math.round(scrollPosition / cardWidth);
      
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    };

    // Listen for scroll events to update dots
    carousel.addEventListener('scroll', updateActiveDot);
    
    // Initialize active dot
    updateActiveDot();

    // Click on dot to scroll to card
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        const firstCard = carousel.querySelector('.snap-start');
        if (!firstCard) return;

        const style = window.getComputedStyle(carousel);
        const gap = parseInt(style.gap || '32', 10);
        const cardWidth = firstCard.clientWidth + gap;

        carousel.scrollTo({
          left: index * cardWidth,
          behavior: 'smooth'
        });
      });
    });
  }
</script>
