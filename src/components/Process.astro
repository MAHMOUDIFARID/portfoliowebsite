---
import { MagnifyingGlassIcon, PaintBrushIcon, CodeIcon, SparkleIcon } from "@phosphor-icons/react";

const steps = [
  {
    title: "Discover",
    description: "I clarify the audience, content model, required pages, and constraints before touching the interface.",
    icon: MagnifyingGlassIcon,
  },
  {
    title: "Design",
    description: "I define layout, typography, and component states so the build has a clear visual direction.",
    icon: PaintBrushIcon,
  },
  {
    title: "Build",
    description: "I implement the UI with Astro, React, Tailwind CSS, or Drupal depending on the project needs.",
    icon: CodeIcon,
  },
  {
    title: "Refine",
    description: "I test responsive behavior, clean up rough edges, and prepare the page for real users.",
    icon: SparkleIcon,
  }
];
---

<section id="process" class="py-32 md:py-48 bg-transparent">
  <div class="section-container">
    <div class="mb-20 text-center max-w-3xl mx-auto">
      <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-white mb-6">
        My Process
      </h2>
      <p class="text-lg md:text-xl text-white/50 font-medium">
        A practical workflow for moving from requirements to a working website.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, index) => (
        <div class="p-8 bg-white/5 backdrop-blur-xl rounded-4xl border border-white/10 shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 group">
          <div class="w-12 h-12 bg-white text-brand-black rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <step.icon size={24} weight="bold" />
          </div>
          <span class="text-[10px] font-medium uppercase tracking-widest text-white/30 mb-2 block">Step 0{index + 1}</span>
          <h3 class="text-2xl font-semibold text-white mb-4">{step.title}</h3>
          <p class="text-white/50 leading-relaxed text-sm">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
