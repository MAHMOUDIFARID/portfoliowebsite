<section id="about" class="py-32 md:py-48 bg-transparent overflow-hidden">
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-32 items-start">
      
      <div>
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-white mb-8 leading-[1.1]">
          Building websites with clear structure and clean interfaces.
        </h2>
        <div class="w-16 h-1 bg-white/20 rounded-full"></div>
      </div>

      <div class="space-y-8">
        <p class="text-xl md:text-2xl text-white/80 leading-relaxed font-medium">
          I am a developer based in Morocco with a background in Big Data and Cloud Computing, focused on practical web projects and maintainable interfaces.
        </p>
        
        <p class="text-lg text-white/50 leading-relaxed">
          My work combines frontend implementation with CMS and automation experience, including <span class="text-white font-medium">Astro</span>, <span class="text-white font-medium">React</span>, <span class="text-white font-medium">Tailwind CSS</span>, and <span class="text-white font-medium">Drupal</span>.
        </p>

        <div class="grid grid-cols-2 gap-8 pt-8">
          <div>
            <h4 class="text-xs font-medium uppercase tracking-widest text-white/30 mb-4">Location</h4>
            <p class="text-white font-medium">Morocco</p>
          </div>
          <div>
            <h4 class="text-xs font-medium uppercase tracking-widest text-white/30 mb-4">Role</h4>
            <p class="text-white font-medium">Creative Developer</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
